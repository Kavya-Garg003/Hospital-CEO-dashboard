# ============================================================
# Aarogya Hospital CEO Dashboard — Environment Configuration
# IMPORTANT: Copy to .env and fill in real values. NEVER commit .env to git.
# ============================================================

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development                         # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Hospital Identity (customizable) ──────────────────────────
HOSPITAL_NAME="Aarogya Multi-Specialty Hospital"
HOSPITAL_LOCATION="Chennai, Tamil Nadu"
CEO_NAME="Dr. CEO Name"
HOSPITAL_BEDS=450
FINANCIAL_YEAR="2024-25"

# ── Database — PostgreSQL (Primary) ───────────────────────────
# Set USE_SQLITE=true to use SQLite fallback (no PostgreSQL needed)
USE_SQLITE=false
DATABASE_URL=postgresql://hospital_user:hospital_pass@localhost:5432/hospital_db
# SQLite fallback path (used when USE_SQLITE=true)
SQLITE_URL=sqlite:///./hospital.db

# ── Database — Neo4j (Graph) ──────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aarogya_graph_pass
NEO4J_DATABASE=neo4j

# ── AI / LLM — OpenRouter (free OpenAI-compatible API) ──────────
# Get free key at: https://openrouter.ai (sign up, no card needed for free models)
# Paste your key below (starts with sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-...
# Free models (no cost):
#   meta-llama/llama-3.1-8b-instruct:free
#   google/gemma-3-12b-it:free
#   deepseek/deepseek-r1:free
# Paid but cheap (<$0.01/1K tokens):
#   google/gemini-flash-1.5
#   mistralai/mistral-7b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Aarogya Hospital Dashboard
AI_MAX_TOKENS=1000

# ── Vector Store (ChromaDB) ───────────────────────────────────
CHROMA_DB_PATH=./chroma_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Security — JWT (RS256) ─────────────────────────────────────
# Generate keys:  openssl genrsa -out private.pem 2048
#                 openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Security — Encryption (AES-256-GCM) ───────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# 32 bytes (64 hex chars) = 256-bit AES key
ENCRYPTION_KEY=change_this_to_64_hex_chars_for_production_never_commit

# ── Security — CORS ───────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AI_CHAT=10/minute

# ── Indian Compliance (DPDP Act 2023) ─────────────────────────
DPO_NAME="Data Protection Officer"
DPO_EMAIL="dpo@aarogyahospital.in"
DPO_PHONE="+91-XXXXXXXXXX"
CONSENT_FORM_VERSION=1.0

# ── Export Settings ───────────────────────────────────────────
PDF_EXPORT_PATH=./exports/pdf
EXCEL_EXPORT_PATH=./exports/excel

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_RETAIN_DAYS=2555          # 7 years per NABH guidelines
