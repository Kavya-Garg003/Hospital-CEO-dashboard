# Vite frontend environment variables
# Copy to .env.local and fill in values

# Backend API URL (set VITE_USE_BACKEND=true when FastAPI is running)
VITE_API_URL=http://localhost:8000
VITE_USE_BACKEND=false

# Optional: Claude API key for direct browser calls (not recommended for production)
# In production, route ALL AI calls through backend /api/ai/chat
# VITE_ANTHROPIC_API_KEY=sk-ant-...
